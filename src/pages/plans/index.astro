---
import TodayReading from '~/components/TodayReading';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { books } from '~/lib/bible';
import { plans, planStats } from '~/lib/plans-data';
import { url } from '~/lib/url';

const names = Object.fromEntries(books.map((b) => [b.id, b.name]));
---

<BaseLayout
  title="Reading plans"
  description="Six free Bible reading plans, from 21 days to the whole Bible in a year."
>
  <h1 class="font-serif text-3xl font-semibold">Reading plans</h1>
  <p class="mt-2 max-w-prose text-ink-muted">
    Pick a plan and a start date. Days are ticked off automatically as you read. Miss a few days? No problem: you can
    adjust the plan at any time.
  </p>
  <div class="mt-6 max-w-2xl">
    <TodayReading client:load names={names} emptyHint={false} />
  </div>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {plans.map((p) => {
      const s = planStats(p);
      return (
        <li>
          <a href={url(`/plans/${p.id}`)} class="card block h-full p-5 text-ink no-underline hover:border-accent">
            <span class="block font-serif text-xl font-semibold">{p.name}</span>
            <span class="mt-1 block text-ink-muted">{p.short}</span>
            <span class="mt-3 block text-sm text-ink-muted">
              {s.days} days · {s.chapters} chapters · about {s.minutesPerDay} min a day
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</BaseLayout>
