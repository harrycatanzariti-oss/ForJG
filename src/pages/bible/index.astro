---
/**
 * /bible — all 66 books, colour-coded by type of writing, with progress rings.
 */
import BookGrid from '~/components/BookGrid';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { books, GENRE_LABELS } from '~/lib/bible';
import { url } from '~/lib/url';

const testaments = (['old', 'new'] as const).map((t) => {
  const inT = books.filter((b) => b.testament === t);
  const genres = [...new Set(inT.map((b) => b.genre))];
  return {
    id: t,
    name: t === 'old' ? 'Old Testament' : 'New Testament',
    groups: genres.map((g) => ({
      heading: GENRE_LABELS[g],
      genre: g,
      books: inT
        .filter((b) => b.genre === g)
        .map((b) => ({ id: b.id, name: b.name, chapters: b.chapters, genre: b.genre })),
    })),
  };
});
---

<BaseLayout title="Bible" description="All 66 books of the Bible, grouped by testament and type of writing.">
  <h1 class="font-serif text-3xl font-semibold">The Bible</h1>
  <p class="mt-2 max-w-prose text-ink-muted">
    66 books written over roughly 1,500 years. Pick any book to start; you can change how simple the text is on every
    chapter. New here? <a href={url('/bible/mark/1')}>Start with Mark</a>, the shortest Gospel, or let{' '}
    <a href={url('/guide')}>the Guide</a> suggest somewhere.
  </p>
  <div class="mt-4 flex flex-wrap gap-2">
    <a href={url('/search')} class="btn btn-secondary">
      Search the Bible
    </a>
    <a href={url('/progress')} class="btn btn-secondary">
      Your progress
    </a>
    <a href={url('/plans')} class="btn btn-secondary">
      Reading plans
    </a>
  </div>
  <BookGrid client:visible testaments={testaments} />
  <p class="mt-8 text-sm text-ink-muted">
    Catholic and Orthodox Bibles include additional Old Testament books.
    <a href={url('/traditions/questions/why-catholic-bibles-have-more-books')}>
      Why do Catholic Bibles have more books?
    </a>
  </p>
</BaseLayout>
