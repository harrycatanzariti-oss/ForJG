---
/**
 * /bible/{book} — book intro card and chapter list.
 */
import BookIntro from '~/components/BookIntro.astro';
import ChapterGrid from '~/components/ChapterGrid';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { books, GENRE_LABELS, getIntro } from '~/lib/bible';
import { url } from '~/lib/url';

export function getStaticPaths() {
  return books.map((book) => ({ params: { book: book.id }, props: { book } }));
}

const { book } = Astro.props;
const intro = getIntro(book.id);
const chapterWord = book.id === 'psalms' ? 'Psalm' : 'Chapter';
---

<BaseLayout
  og={`bible/${book.id}`}
  title={book.name}
  description={intro?.overview ?? `Read ${book.name}, all ${book.chapters} chapters, at the level that suits you.`}
>
  <nav aria-label="Breadcrumb" class="mb-1 text-sm text-ink-muted">
    <a href={url('/bible')} class="text-ink-muted">
      Bible
    </a>
  </nav>
  <h1 class="text-[30px] leading-tight font-semibold tracking-[-0.03em]">{book.name}</h1>
  <p class="mt-1 text-ink-muted">
    {book.testament === 'old' ? 'Old Testament' : 'New Testament'} ·
    <span style={`color: var(--g-${book.genre})`}>●</span>
    {GENRE_LABELS[book.genre]} · {book.chapters}
    {book.chapters === 1 ? 'chapter' : 'chapters'}
  </p>

  {intro && (
    <div class="mt-6">
      <BookIntro book={book} intro={intro} />
    </div>
  )}

  <h2 class="mt-8 mb-3 text-lg font-semibold">{chapterWord === 'Psalm' ? 'Psalms' : 'Chapters'}</h2>
  <ChapterGrid client:visible bookId={book.id} chapters={book.chapters} word={chapterWord} />
  <p class="mt-6">
    <a href={url(`/bible/${book.id}/1`)} class="btn btn-primary">
      Start reading {book.name}
    </a>
  </p>
</BaseLayout>
