---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { url } from '~/lib/url';
---

<BaseLayout title="Page not found">
  <h1 class="font-serif text-3xl font-semibold">Page not found</h1>
  <p class="mt-3 text-ink-muted">That page does not exist. It may have moved.</p>
  <p class="mt-6">
    <a href={url('/bible')} class="btn btn-primary">
      Go to the Bible
    </a>
  </p>
</BaseLayout>
