---
import ContinueReading from '~/components/ContinueReading';
import TodayReading from '~/components/TodayReading';
import Icon from '~/components/ui/Icon.astro';
import { SITE_TAGLINE } from '~/config';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { books } from '~/lib/bible';
import { url } from '~/lib/url';

const names = Object.fromEntries(books.map((b) => [b.id, b.name]));
const examples = ['I’m afraid of dying', 'I’m grieving', 'God feels far away', 'Where do I start?'];
---

<BaseLayout>
  <section class="pt-6 pb-8 text-center sm:pt-14 sm:pb-12">
    <a
      href={url('/about#church-colours')}
      class="blur-in inline-flex items-center gap-2 rounded-full bg-surface px-3 py-1.5 text-sm text-ink-muted no-underline ring-1 ring-black/5 dark:ring-white/10"
    >
      <span class="season-dot size-2 rounded-full" aria-hidden="true"></span>
      <span data-season-label>Today in the church year</span>
    </a>
    <h1
      class="blur-in mx-auto mt-5 max-w-2xl text-[40px] leading-[1.04] font-semibold tracking-[-0.04em] text-balance sm:text-[60px]"
      style="--d: 80ms"
    >
      {SITE_TAGLINE}
    </h1>
    <p class="blur-in mx-auto mt-4 max-w-md text-lg text-ink-muted" style="--d: 160ms">
      Every chapter at the level that suits you, and how Christian traditions read it. Free, no ads, no account.
    </p>
  </section>

  <!-- A plain HTML form: it works even before any JavaScript has loaded. -->
  <form
    action={url('/guide')}
    method="get"
    class="card fade-up mx-auto max-w-2xl rounded-3xl p-5 sm:p-6"
    style="--d: 240ms"
  >
    <label for="home-guide" class="block text-xl font-semibold tracking-tight">
      Where are you today?
    </label>
    <p class="mt-1 text-sm text-ink-muted">
      Tell us in your own words and we’ll point you to passages and next steps. Nothing you type leaves your device.
    </p>
    <div class="mt-4 flex flex-col gap-2 sm:flex-row">
      <input
        id="home-guide"
        name="q"
        type="text"
        autocomplete="off"
        placeholder="e.g. I’m mourning and God feels far away"
        class="min-h-12 w-full flex-1 rounded-full border border-line bg-paper px-5 text-base text-ink"
      />
      <button type="submit" class="btn btn-primary min-h-12 px-6">
        Guide me
      </button>
    </div>
    <ul class="mt-4 flex flex-wrap gap-2">
      {examples.map((e) => (
        <li>
          <a
            href={`${url('/guide')}?q=${encodeURIComponent(e)}`}
            class="press inline-flex min-h-11 items-center rounded-full bg-surface-2 px-4 text-sm text-ink no-underline hover:bg-accent-soft"
          >
            {e}
          </a>
        </li>
      ))}
    </ul>
  </form>

  <div class="mx-auto mt-6 grid max-w-4xl gap-4 sm:grid-cols-2">
    <ContinueReading client:idle names={names} />
    <TodayReading client:idle names={names} />
    <a
      href={url('/bible')}
      class="card press reveal flex items-start gap-4 p-5 text-ink no-underline hover:border-accent"
    >
      <Icon name="book" class="mt-1 size-7 shrink-0 text-accent" />
      <span>
        <span class="block text-xl font-semibold tracking-tight">Start reading</span>
        <span class="mt-1 block text-ink-muted">
          Pick any of the 66 books. A good first choice is Mark, the shortest Gospel.
        </span>
      </span>
    </a>
    <a
      href={url('/traditions')}
      class="card press reveal flex items-start gap-4 p-5 text-ink no-underline hover:border-accent"
    >
      <Icon name="compass" class="mt-1 size-7 shrink-0 text-accent" />
      <span>
        <span class="block text-xl font-semibold tracking-tight">Explore traditions</span>
        <span class="mt-1 block text-ink-muted">
          How Catholic, Orthodox, Protestant and other churches believe and worship, described fairly in their own
          words.
        </span>
      </span>
    </a>
  </div>

  <section class="reveal mx-auto mt-14 max-w-4xl">
    <h2 class="text-lg font-semibold">How the reading levels work</h2>
    <ol class="mt-3 list-decimal space-y-2 pl-5 text-ink-muted">
      <li>
        <strong class="text-ink">Original</strong>: the King James Version of 1611.
      </li>
      <li>
        <strong class="text-ink">Modern</strong>: the Berean Standard Bible (or World English Bible) in today's English.
      </li>
      <li>
        <strong class="text-ink">Plain</strong>: a simple retelling of the chapter in short paragraphs.
      </li>
      <li>
        <strong class="text-ink">Summary</strong>: the big idea, key points and a question to reflect on.
      </li>
    </ol>
    <p class="mt-3 text-sm text-ink-muted">
      Plain and Summary are written by hand for Genesis, Psalms 1–23, Matthew, Mark, John, Acts and Romans. Every other
      chapter gets a quick outline from its section headings until its retelling is written.
      <a href={url('/about')}>How they were written</a>.
    </p>
  </section>
</BaseLayout>
