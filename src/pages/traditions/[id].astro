---
/**
 * /traditions/{id}: a tradition's profile. Sections are collapsible so the
 * page stays short on phones; all text is in the HTML for search engines.
 */
import Gloss from '~/components/Gloss.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { traditions } from '~/lib/content';
import { BELIEF_TOPICS, BELIEF_TOPIC_LABELS } from '~/lib/schemas';
import { FAMILY_LABELS, NEUTRALITY_NOTE, OTHER_GROUPS_NOTE } from '~/lib/traditions-meta';
import { url } from '~/lib/url';

export function getStaticPaths() {
  return traditions.map((t) => ({ params: { id: t.id }, props: { t } }));
}
const { t } = Astro.props;
const seen = new Set<string>();
const others = traditions.filter((o) => o.id !== t.id && !o.otherGroup).slice(0, 3);
const compareWith = t.id === 'catholic' ? 'baptist' : 'catholic';
const sections = [
  ['history', 'History'],
  ['beliefs', 'Beliefs'],
  ['worship', 'Worship'],
  ['visit', 'First visit'],
  ['texts', 'Key texts'],
];
---

<BaseLayout title={t.name} description={t.originSummary.slice(0, 155)} width="reading">
  <nav aria-label="Breadcrumb" class="mb-1 text-sm">
    <a href={url('/traditions')} class="text-ink-muted">
      Traditions
    </a>
  </nav>
  <h1 class="font-serif text-3xl font-semibold">{t.name}</h1>
  <p class="mt-1 flex items-center gap-2 text-ink-muted">
    <span class="size-3 rounded-full" style={`background: var(--f-${t.family})`} aria-hidden="true"></span>
    {FAMILY_LABELS[t.family]} · {t.foundedApprox}
  </p>
  {t.otherGroup && <p class="mt-4 rounded-xl bg-surface-2 p-4 text-sm">{OTHER_GROUPS_NOTE}</p>}

  <nav
    aria-label="On this page"
    class="sticky top-14 z-10 -mx-4 mt-4 overflow-x-auto bg-paper/95 px-4 py-2 backdrop-blur"
  >
    <ul class="flex gap-2 whitespace-nowrap">
      {sections.map(([id, label]) => (
        <li>
          <a
            href={`#${id}`}
            class="inline-flex min-h-11 items-center rounded-full bg-surface-2 px-4 text-sm text-ink no-underline"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <section id="history" class="mt-6 scroll-mt-32">
    <h2 class="text-xl font-semibold">History</h2>
    <p class="mt-2 leading-relaxed">
      <Gloss text={t.originSummary} seen={seen} />
    </p>
    <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
      <div class="card p-3">
        <dt class="font-semibold">Key figures</dt>
        <dd class="text-ink-muted">{t.keyFigures.join(', ')}</dd>
      </div>
      <div class="card p-3">
        <dt class="font-semibold">Size (approx.)</dt>
        <dd class="text-ink-muted">
          {t.globalSizeApprox.figure} ({t.globalSizeApprox.year}).
          <span class="block text-xs">Source: {t.globalSizeApprox.source}</span>
          {t.globalSizeApprox.note && <span class="block text-xs">{t.globalSizeApprox.note}</span>}
        </dd>
      </div>
      <div class="card p-3 sm:col-span-2">
        <dt class="font-semibold">Where it is common</dt>
        <dd class="text-ink-muted">{t.whereCommon.join(', ')}</dd>
      </div>
    </dl>
    <p class="mt-4 rounded-xl bg-accent-soft p-4 text-sm">
      <strong>Diversity:</strong> {t.diversity}
    </p>
  </section>

  <section id="beliefs" class="mt-10 scroll-mt-32">
    <h2 class="text-xl font-semibold">Beliefs</h2>
    <p class="mt-1 text-sm text-ink-muted">Tap a topic for more detail and the source.</p>
    <div class="mt-3 space-y-2">
      {BELIEF_TOPICS.map((topic) => {
        const b = t.beliefs[topic];
        return (
          <details class="card group p-0">
            <summary class="flex min-h-11 cursor-pointer list-none items-start justify-between gap-3 p-4">
              <span>
                <span class="block text-sm font-semibold text-ink-muted">{BELIEF_TOPIC_LABELS[topic]}</span>
                <span class="mt-1 block">
                  <Gloss text={b.summary} seen={seen} />
                </span>
              </span>
              <span class="mt-1 shrink-0 text-accent transition-transform group-open:rotate-180" aria-hidden="true">
                ▾
              </span>
            </summary>
            <div class="border-t border-line px-4 pt-3 pb-4">
              <p class="leading-relaxed">
                <Gloss text={b.detail} seen={seen} />
              </p>
              <p class="mt-2 text-xs text-ink-muted">Source: {b.source}</p>
            </div>
          </details>
        );
      })}
    </div>
    <p class="mt-4">
      <a href={url(`/traditions/compare?a=${t.id}&b=${compareWith}`)} class="btn btn-secondary">
        Compare with another tradition
      </a>
    </p>
  </section>

  <section id="worship" class="mt-10 scroll-mt-32">
    <h2 class="text-xl font-semibold">Worship</h2>
    <dl class="mt-3 space-y-3">
      <div>
        <dt class="font-semibold">Style</dt>
        <dd class="text-ink-muted">{t.worship.style}</dd>
      </div>
      <div>
        <dt class="font-semibold">A typical service</dt>
        <dd class="text-ink-muted">{t.worship.typicalService}</dd>
      </div>
      <div>
        <dt class="font-semibold">Calendar</dt>
        <dd class="text-ink-muted">{t.worship.calendar}</dd>
      </div>
      <div>
        <dt class="font-semibold">Music</dt>
        <dd class="text-ink-muted">{t.worship.music}</dd>
      </div>
    </dl>
  </section>

  <section id="visit" class="mt-10 scroll-mt-32">
    <h2 class="text-xl font-semibold">Your first visit</h2>
    <div class="card mt-3 space-y-3 p-4">
      <p>
        <strong>What to expect:</strong> {t.firstVisit.expect}
      </p>
      <p>
        <strong>What to wear:</strong> {t.firstVisit.wear}
      </p>
      <div>
        <p class="font-semibold">Good to know</p>
        <ul class="mt-1 list-disc space-y-1 pl-5">
          {t.firstVisit.etiquette.map((e) => (
            <li>{e}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="texts" class="mt-10 scroll-mt-32">
    <h2 class="text-xl font-semibold">Key texts</h2>
    <ul class="mt-3 space-y-2">
      {t.keyTexts.map((k) => (
        <li>
          <strong>{k.title}</strong>: <span class="text-ink-muted">{k.note}</span>
        </li>
      ))}
    </ul>
    <h3 class="mt-6 font-semibold">Further reading</h3>
    <ul class="mt-2 list-disc space-y-1 pl-5">
      {t.furtherReading.map((r) => (
        <li>
          {r.url ? (
            <a href={r.url} rel="noopener">
              {r.title}
            </a>
          ) : (
            <em>{r.title}</em>
          )}
          {r.author && <span class="text-ink-muted">, {r.author}</span>}
        </li>
      ))}
    </ul>
  </section>

  <p class="mt-10 rounded-xl bg-surface-2 p-4 text-sm text-ink-muted">
    {NEUTRALITY_NOTE} Spotted an error? Content is in <code>src/data/traditions/{t.id}.json</code>.
  </p>

  <section class="mt-8">
    <h2 class="text-lg font-semibold">Explore other traditions</h2>
    <ul class="mt-2 flex flex-wrap gap-2">
      {others.map((o) => (
        <li>
          <a href={url(`/traditions/${o.id}`)} class="btn btn-secondary text-sm">
            {o.shortName}
          </a>
        </li>
      ))}
      <li>
        <a href={url('/traditions')} class="btn btn-secondary text-sm">
          All traditions
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>
