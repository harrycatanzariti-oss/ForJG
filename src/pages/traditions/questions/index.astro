---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { bigQuestions } from '~/lib/content';
import { url } from '~/lib/url';
---

<BaseLayout
  og="traditions"
  title="Big questions"
  description="Questions where Christian traditions differ, with every major view explained fairly."
  width="reading"
>
  <nav aria-label="Breadcrumb" class="mb-1 text-sm">
    <a href={url('/traditions')} class="text-ink-muted">
      Traditions
    </a>
  </nav>
  <h1 class="font-serif text-3xl font-semibold">Big questions</h1>
  <p class="mt-2 text-ink-muted">
    Short explainers on questions where Christians genuinely disagree. Each view is described as its own holders would
    describe it, with the passages they point to.
  </p>
  <ul class="mt-6 space-y-3">
    {bigQuestions.map((q) => (
      <li>
        <a href={url(`/traditions/questions/${q.id}`)} class="card block p-4 text-ink no-underline hover:border-accent">
          <span class="block font-serif text-xl font-semibold">{q.title}</span>
          <span class="mt-1 block text-sm text-ink-muted">{q.views.length} main views</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
