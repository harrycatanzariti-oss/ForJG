---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { url } from '~/lib/url';
---

<BaseLayout title="You’re offline" description="This page isn’t saved for offline reading yet." width="reading">
  <h1 class="text-[30px] leading-tight font-semibold tracking-[-0.03em]">You’re offline</h1>
  <p class="mt-3 text-lg text-ink-muted">
    This page hasn’t been saved on this device yet. Chapters and pages you have opened before are available offline,
    along with the main pages of the site.
  </p>
  <ul class="mt-6 flex flex-wrap gap-2">
    <li>
      <a href={url('/')} class="btn btn-primary">
        Home
      </a>
    </li>
    <li>
      <a href={url('/bible')} class="btn btn-secondary">
        Bible
      </a>
    </li>
    <li>
      <a href={url('/progress')} class="btn btn-secondary">
        Your progress
      </a>
    </li>
  </ul>
</BaseLayout>
