  'chevron-right': 'm9 18 6-6-6-6',
  arrow: 'M5 12h14m-6-6 6 6-6 6',
  lamp: 'M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.4 1 1.1 1 1.8V16h5v-.3c0-.7.4-1.4 1-1.8A6 6 0 0 0 12 3z',
