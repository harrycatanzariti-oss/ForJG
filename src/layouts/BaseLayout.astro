---
/**
 * The frame around every page: <head> tags, header, navigation and footer.
 */
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/literata/wght.css';
// Font files to fetch early: the interface font and the main scripture font.
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
// The URL of the main (Latin) scripture font file, so we can ask the browser to fetch it early.
import literataLatin from '@fontsource-variable/literata/files/literata-latin-wght-normal.woff2?url';
import '~/styles/global.css';
import Icon from '~/components/ui/Icon.astro';
import ThemeToggle from '~/components/ui/ThemeToggle';
import { NAV, SITE_DESCRIPTION, SITE_NAME } from '~/config';
import { liturgicalDay } from '~/lib/liturgical.js';
// The calendar code as text, so it can run inline before the page is drawn.
import liturgicalSource from '~/lib/liturgical.js?raw';
import { url } from '~/lib/url';

interface Props {
  /** Page title; the site name is added automatically. */
  title?: string;
  description?: string;
  /** Use a narrower column for reading pages. */
  width?: 'reading' | 'wide';
  /** Social preview image slug under /og/, e.g. "bible/john". */
  og?: string;
}

const { title, description = SITE_DESCRIPTION, width = 'wide', og = 'default' } = Astro.props;
const ogImage = Astro.site ? new URL(url(`/og/${og}.png`), Astro.site).href : url(`/og/${og}.png`);
const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} · Read the Bible, understand the traditions`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const target = url(href).replace(/\/$/, '') || '/';
  // Home is only "current" on the home page itself, not on every page below it.
  return href === '/' ? path === target : path === target || path.startsWith(`${target}/`);
};
const container = width === 'reading' ? 'max-w-2xl' : 'max-w-5xl';

// The colour as of the build; the inline script below updates it to the
// visitor's actual date, so it is always right on the day.
const buildDay = liturgicalDay(new Date());
const colourScript = `(function(){${liturgicalSource.replace(/^export /gm, '')}
  var choice = 'season';
  try { choice = (JSON.parse(localStorage.getItem('lamplight:settings') || '{}') || {}).accent || 'season'; } catch (e) {}
  var today = liturgicalDay(new Date());
  document.documentElement.dataset.vestment = ['green','purple','rose','red','white'].indexOf(choice) >= 0 ? choice : today.colour;
  window.__liturgicalDay = today;
})();`;
---

<!doctype html>
<html lang="en" data-vestment={buildDay.colour}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0f14" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={literataLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={url('/icons/apple-touch-icon.png')} />
    <!--
      Runs before the page is drawn so the right theme and text size are used
      immediately (no flash of the light theme for dark-mode readers).
      Keep in sync with applySettings() in src/lib/settings.ts.
    -->
    <script is:inline>
      /* eslint-disable no-var -- plain old JavaScript so it runs in every browser */
      (function () {
        var s = {};
        try {
          s = JSON.parse(localStorage.getItem('lamplight:settings') || '{}') || {};
        } catch (_e) {
          /* storage blocked: use defaults */
        }
        var theme = s.theme || 'system';
        var dark = theme === 'dark' || (theme === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        var root = document.documentElement;
        if (dark) root.classList.add('dark');
        root.style.colorScheme = dark ? 'dark' : 'light';
        root.dataset.textSize = String([1, 2, 3, 4].indexOf(s.textSize) >= 0 ? s.textSize : 2);
      })();
    </script>
    <!-- Sets today's vestment colour (the site's accent) before the page is drawn. -->
    <script is:inline set:html={colourScript} />
    <slot name="head" />
    {import.meta.env.PROD && <script is:inline define:vars={{ swUrl: url('/sw.js'), scope: url('/') }}>
      // Register the service worker (offline support) once the page has loaded.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register(swUrl, { scope: scope }).catch(function () {});
        });
      }
    </script>}
  </head>
  <body class="flex flex-col">
    <a href="#main" class="sr-only-focusable fixed top-2 left-2 z-50 rounded-lg bg-surface px-4 py-2 shadow">
      Skip to content
    </a>
    <!--
      The header holds all navigation. It retracts (slides up out of the way)
      while you scroll down to read, and comes back as soon as you scroll up.
      See the script at the end of the page.
    -->
    <header
      id="site-header"
      class="site-header sticky top-0 z-30 border-b border-black/5 bg-surface/75 backdrop-blur-xl backdrop-saturate-150 dark:border-white/5"
    >
      <div class="mx-auto flex h-14 max-w-5xl items-center gap-3 px-4">
        <a
          href={url('/')}
          class="flex items-center gap-2 text-[17px] font-semibold tracking-tight text-ink no-underline"
        >
          <Icon name="lamp" class="size-6 text-accent" />
          {SITE_NAME}
        </a>
        <!-- Today's church colour: the dot is the vestment colour for the day. -->
        <a
          href={url('/about#church-colours')}
          class="inline-flex items-center gap-2 rounded-full px-2 py-1 text-xs text-ink-muted no-underline hover:bg-surface-2 hover:text-ink"
        >
          <span class="season-dot size-2 rounded-full" aria-hidden="true"></span>
          <span class="sr-only">Today's church colour: </span>
          <span class="sr-only md:not-sr-only" data-season-label>
            {buildDay.day ?? buildDay.season}
          </span>
        </a>
        <nav aria-label="Main" class="ml-auto hidden sm:block">
          <ul class="flex items-center gap-1">
            {NAV.map((item) => (
              <li>
                <a
                  href={url(item.href)}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class="rounded-full px-3 py-2 text-sm text-ink-muted no-underline hover:bg-surface-2 hover:text-ink aria-[current=page]:bg-accent-fill aria-[current=page]:text-ink"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="ml-auto flex items-center sm:ml-0">
          <a
            href={url('/search')}
            class="flex size-11 items-center justify-center rounded-full text-ink-muted hover:bg-surface-2 hover:text-ink"
            aria-label="Search the Bible"
          >
            <Icon name="search" />
          </a>
          <ThemeToggle client:idle />
          <a
            href={url('/settings')}
            class="flex size-11 items-center justify-center rounded-full text-ink-muted hover:bg-surface-2 hover:text-ink"
            aria-label="Settings"
            aria-current={isActive('/settings') ? 'page' : undefined}
          >
            <Icon name="settings" />
          </a>
        </div>
      </div>
      <!-- On phones the links sit in a second row of pills (Otis style). -->
      <nav aria-label="Main" class="sm:hidden">
        <ul class="flex justify-between gap-0.5 overflow-x-auto px-2 pb-2 min-[360px]:px-3">
          {NAV.map((item) => (
            <li class="shrink-0">
              <a
                href={url(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="inline-flex min-h-11 items-center rounded-full px-2 text-sm text-ink-muted min-[360px]:px-2.5 no-underline hover:bg-surface-2 hover:text-ink aria-[current=page]:bg-accent-fill aria-[current=page]:font-medium aria-[current=page]:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main" class={`mx-auto w-full ${container} flex-1 px-4 pt-6 pb-12`}>
      <slot />
    </main>

    <footer class="border-t border-line pt-8 pb-[calc(2rem+env(safe-area-inset-bottom))] text-sm text-ink-muted">
      <div class="mx-auto max-w-5xl px-4">
        <nav aria-label="More pages">
          <ul class="flex flex-wrap gap-x-5 gap-y-2">
            <li>
              <a href={url('/search')} class="text-ink-muted">
                Search
              </a>
            </li>
            <li>
              <a href={url('/progress')} class="text-ink-muted">
                Progress
              </a>
            </li>
            <li>
              <a href={url('/glossary')} class="text-ink-muted">
                Glossary
              </a>
            </li>
            <li>
              <a href={url('/traditions/questions')} class="text-ink-muted">
                Big questions
              </a>
            </li>
            <li>
              <a href={url('/about')} class="text-ink-muted">
                About
              </a>
            </li>
            <li>
              <a href={url('/settings')} class="text-ink-muted">
                Settings
              </a>
            </li>
          </ul>
        </nav>
        <p class="mt-4">
          {SITE_NAME} is free, has no ads and no tracking. Your reading data stays in this browser. Bible text: KJV, BSB
          and WEB (public domain).
        </p>
      </div>
    </footer>

    <!-- Fill in today's season name wherever it appears. -->
    <script is:inline>
      (function () {
        const d = window.__liturgicalDay;
        if (!d) return;
        document.querySelectorAll('[data-season-label]').forEach(function (el) {
          el.textContent = d.day || d.season;
        });
      })();
    </script>
    <!--
      Retracting header: hide on scroll down, show on scroll up.
      It also publishes the header's height as CSS variables so sticky bars
      and "jump to" links line up underneath it:
        --header-h       full header height
        --header-offset  how much of the header is showing right now (0 when hidden)
    -->
    <script is:inline>
      (function () {
        const header = document.getElementById('site-header');
        if (!header) return;
        const root = document.documentElement;
        let lastY = window.scrollY;
        let hidden = false;
        let ticking = false;
        const measure = function () {
          root.style.setProperty('--header-h', header.offsetHeight + 'px');
          root.style.setProperty('--header-offset', hidden ? '0px' : header.offsetHeight + 'px');
        };
        const setHidden = function (value) {
          if (value === hidden) return;
          hidden = value;
          header.classList.toggle('is-retracted', hidden);
          measure();
        };
        const update = function () {
          ticking = false;
          const y = window.scrollY;
          const delta = y - lastY;
          // Always show near the top, and never hide while something in the header has keyboard focus.
          if (y < header.offsetHeight || header.contains(document.activeElement)) setHidden(false);
          else if (delta > 6) setHidden(true);
          else if (delta < -6) setHidden(false);
          if (Math.abs(delta) > 6) lastY = y;
        };
        window.addEventListener(
          'scroll',
          function () {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true },
        );
        header.addEventListener('focusin', function () {
          setHidden(false);
        });
        if ('ResizeObserver' in window) new ResizeObserver(measure).observe(header);
        measure();
      })();
    </script>
  </body>
</html>
