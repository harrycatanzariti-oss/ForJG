# Cloudflare Pages reads this file to set HTTP headers. (GitHub Pages ignores it.)

# Files in /_astro/ have a content hash in their name, so they can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Bible text rarely changes; let browsers keep it for a day and revalidate after.
/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), browsing-topics=()

# The service worker must always be checked for updates.
/sw.js
  Cache-Control: no-cache
